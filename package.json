{
  "name": "esm-project-starter",
  "version": "1.0.0",
  "description": "The starter template I use to create new ESM projects.",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/instrumentation-pino": "^0.55.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "dotenv": "^17.2.3",
    "es-toolkit": "^1.41.0",
    "hono": "^4.10.5",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.2.0",
    "p-queue": "^9.0.0",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.1.2",
    "shartjs": "^1.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "Parth Koshti (https://github.com/parthkoshti)",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0"
}
